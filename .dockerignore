!Dockerfile
!config.example.yaml
!docker-dist/
!docker-dist/amd64/
!docker-dist/amd64/mtproto
!docker-dist/amd64/docker-entrypoint
!docker-dist/arm64/
!docker-dist/arm64/mtproto
!docker-dist/arm64/docker-entrypoint
